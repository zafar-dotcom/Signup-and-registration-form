@model IEnumerable<Complete.Models.ExportPdfEmployeemodel> 
@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <script src="https://code.jquery.com/jquery-3.6.3.min.js" integrity="sha256-pvPw+upLPUjgMXY0G+8O0xUf+/Im1MZjXxxgOcBQBXU=" crossorigin="anonymous"></script>
   
   <meta name="viewport" content="width=device-width" />
    <title>Exportpdf</title>
    <style type="text/css">
    body{
        font-family :Arial;
        font-size :9pt;
    }    
    </style>
</head>
<body>
    <h4>Employee</h4>
    <hr />
    <div id="Grid">
        <table cellpadding="5" cellspacing="0" style="border: 1px solid #ccc ;font-size :9pt;" >
            <tr>
                <th style="background-color:#B8DBFD ;border: 1px solid #ccc " >@Html.DisplayNameFor(m=>m.Id)</th>
                <th style="background-color:#B8DBFD ;border: 1px solid #ccc ">@Html.DisplayNameFor(m=>m.FName)</th>
                <th style="background-color:#B8DBFD ;border: 1px solid #ccc ">@Html.DisplayNameFor(m=>m.LName)</th>
                <th style="background-color:#B8DBFD ;border: 1px solid #ccc " >@Html.DisplayNameFor(m=>m.Job)</th>
                <th style="background-color:#B8DBFD ;border: 1px solid #ccc ">@Html.DisplayNameFor(m=>m.Amount)</th>
                <th style="background-color:#B8DBFD ;border: 1px solid #ccc ">@Html.DisplayNameFor(m=>m.Date_time)</th>
            </tr>
            @foreach(var item in Model)
            {
                <tr>
                    <td style="width:120px ; border: 1px solid #ccc">@item.Id @*@Html.DisplayFor(ModelItem=>item.Id) *@  </td>
                    <td style="width:120px ; border: 1px solid #ccc">@item.FName @* @Html.DisplayFor(ModelItem=>item.FName)  *@</td>
                    <td style="width:120px ; border: 1px solid #ccc">@item.LName @* @Html.DisplayFor(Modelitem=>item.LName) *@</td>
                    <td style="width:120px ; border: 1px solid #ccc">@item.Job  @* @Html.DisplayFor(ModelItem=>item.Job) *@ </td>
                    <td style="width:120px ; border: 1px solid #ccc">@item.Amount  @* @Html.DisplayFor(ModelItem=>item.Amount) *@ </td>
                    <td style="width:120px ; border: 1px solid #ccc">@item.Date_time  @* @Html.DisplayFor(ModelItem=>item.Date_time)*@ </td>
                </tr>
            }
        </table>
    </div>
    <br />
    <br />


    <br />
    <br />
    @using (Html.BeginForm("ExportToPdf", "Excell", FormMethod.Post))
    {
        <input type="hidden" name="GridHtml" />
        <input type="submit" id="btnSubmit" value="Export" />
    }
   @* <script type="text/javascript" src="http://ajax.googleapis.com/ajax/libs/jquery/1.8.3/jquery.min.js"></script>
   *@
   <script type="text/javascript">
        $(function () {
            $("#btnSubmit").click(function () {
                $("input[name='GridHtml']").val($("#Grid").html());
            });
        });
    </script>
  
</body>
</html>
