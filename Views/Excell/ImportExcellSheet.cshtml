@{
    ViewData["Title"] = "Import Excell sheet";
}
<div class="container">
 
 
       
    <form enctype="multipart/form-data" asp-action="ImportExcellSheet" asp-controller="Excell">
        
        <table>          
            <tr>
                
                <th>Upload Excell File</th> 

            </tr>    
            
                    <tr>
               
                          <td>
                                 <input type="file" name="FormFile" id="FormFile" accept=".xlx,.xlxs" />
                          </td>
                    </tr>

            <tr>

                @*    <td>  <input class="btn btn-primary" type="submit" value="Upload" />
                </td>*@
            </tr>
        </table>
       <input class="btn btn-primary" type="submit" value="Upload"  />
        <div style="color:green">
            @ViewBag.Message
        </div>

    </form>
    <br />
    <br />
    <br />
    <br />
    <form method="post" enctype="multipart/form-data" asp-controller="Excell" asp-action="Export_To_excell">
        <table>
            <tr>
                <th>Download Excell File</th>
            </tr>
            <tr>
                <td>
                    <input class="btn btn-primary" type="submit" value="Export File" />
                </td>
            </tr>
        </table>
    </form>

    @* follwoing is the view to export excell file  *@
    
    
</div>