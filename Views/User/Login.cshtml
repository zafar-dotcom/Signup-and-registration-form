@{
    ViewBag.Title = "Index";
}
<head>
    <script src="https://apis.google.com/js/platform.js" async defer></script>
    <meta name="google-signin-client_id" content="422143680280-6u3st7q80u5l3i9ot1agnnvhddnuf8kj.apps.googleusercontent.com">
    <script>

        function onSignIn(googleUser) {
            var profile = googleUser.getBasicProfile();
            console.log('ID: ' + profile.getId()); // Do not send to your backend! Use an ID token instead.
            console.log('Name: ' + profile.getName());
            console.log('Image URL: ' + profile.getImageUrl());
            console.log('Email: ' + profile.getEmail()); // This is null if the 'email' scope is not present.
        }
    </script>
</head>

<form asp-controller="User" asp-action="Login">
    <div class="container">
        <div class=" row">
            <div class="col-lg-3">
                <div class="form-group">
                    <label>Email</label>
                    <input type="text" class="form-control" name="Email" />
                </div>
                <div class="form-group">
                    <label>Password</label>
                    <input type="password" class="form-control" name="Password" />
                </div>
                <button class="btn btn-primary" type="submit">Login</button>
                <a asp-controller="User" asp-action="Registration">Registration</a>
            </div>
            <div class="color:red">
                @Html.Raw(TempData["Loginfail"])
                @Html.Raw(TempData["Registrationsuccessfull"])
            </div>
            <div class="well">
                <table class="table table-bordered">
                    <thead>
                        <tr class="well alert-success">
                            <th>Use other survice to login</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr class="">
                            <td>
                                
                            </td>
                        </tr>

                    </tbody>
                </table>
            </div>

        </div>
      
    </div>
</form>

<div class="g-signin2" data-onsuccess="onSignIn"></div>