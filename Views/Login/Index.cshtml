@{
}

@Html.Raw(TempData["registered"])
<div class=" container">
    <form asp-controller="Register" asp-action="Login_user">
        <div class="row">
            <div class="col-lg-3">
                <div class="form-group">
                    <label>Email:</label>
                    <input type="text" class="form-control" name="email" />
                </div>
                <div class="form-group">
                    <label>Password:</label>
                    <input type="password" class="form-control" name="password" />
                </div>
                <div>
                    <button type="submit" class="btn btn-primary">Login</button>
                    <a asp-controller="Home" asp-action="Registration">Register</a>
                </div>
               
                <div style="color:red;">
                    @ViewBag.message
                </div>
            </div>
        </div>
    </form>
</div>